{
  "name": "@amriogit/injector",
  "version": "0.3.0",
  "type": "module",
  "description": "轻量 DI 容器 — Injector, BaseService, InjectionToken。零外部依赖，支持 SSR，Vue 集成。",
  "keywords": [
    "di",
    "dependency-injection",
    "injector",
    "typescript",
    "vue",
    "ssr"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amriogit/injector.git"
  },
  "bugs": {
    "url": "https://github.com/amriogit/injector/issues"
  },
  "homepage": "https://github.com/amriogit/injector#readme",
  "main": "./dist/injector.js",
  "types": "./dist/injector.d.ts",
  "exports": {
    ".": "./dist/injector.js",
    "./vue": "./dist/injector-vue.js",
    "./vue2": "./dist/injector-vue2.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/vue": "^2.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.34"
  },
  "license": "MIT"
}
